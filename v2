<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f6f3eb"><title>LangLang — a daily language puzzle</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap');
:root{--paper:#f6f3eb;--ink:#252d28;--muted:#69746d;--line:#d7d8cf;--green:#245d45;--soft:#e8eee6;--red:#9d463c}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:'DM Sans',Arial,sans-serif;-webkit-font-smoothing:antialiased}button,textarea{font:inherit}button{cursor:pointer}a{color:inherit}.shell{max-width:880px;margin:auto;padding:0 30px 90px}.top{display:flex;align-items:center;justify-content:space-between;padding:26px 0 20px;border-bottom:1px solid var(--ink)}.brand{font-family:'Libre Baskerville',Georgia,serif;font-weight:700;font-size:25px;letter-spacing:-1.5px}.brand span{color:var(--green)}.top-right{font-size:12px;color:var(--muted);letter-spacing:.12em;text-transform:uppercase}.intro{padding:62px 0 38px}.eyebrow{font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--green)}h1{font-family:'Libre Baskerville',Georgia,serif;font-weight:400;letter-spacing:-.055em;font-size:clamp(39px,6vw,65px);line-height:1.13;max-width:700px;margin:18px 0}h1 em{font-weight:400;color:var(--green)}.intro p{max-width:520px;font-size:16px;line-height:1.75;color:#58645b;margin:18px 0 0}.bar{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:14px 0;gap:12px;flex-wrap:wrap}.bar strong{font-size:13px}.bar span{font-size:12px;color:var(--muted)}.levels{display:flex;gap:6px;margin:30px 0 34px}.level{border:1px solid var(--line);background:transparent;padding:12px 22px;font-size:13px;font-weight:700;letter-spacing:.02em;border-radius:3px;transition:background .15s}.level:hover{background:#ebece3}.level.active{background:var(--ink);color:white;border-color:var(--ink)}.level small{font-size:10px;margin-left:7px;opacity:.65}.section-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:17px}.section-head h2{font-family:'Libre Baskerville',Georgia,serif;font-size:23px;font-weight:400;margin:0}.section-head span{font-size:12px;color:var(--muted)}.note{font-size:13px;color:var(--muted);line-height:1.6;margin:0 0 22px}.examples{border-top:1px solid var(--ink)}.example{display:grid;grid-template-columns:34px 1fr 1fr;gap:16px;align-items:center;padding:20px 7px;border-bottom:1px solid var(--line)}.number{font-size:11px;color:#9a9e94}.invented{font-family:'Libre Baskerville',Georgia,serif;font-size:17px;line-height:1.5}.english{font-size:14px;color:#58635b;line-height:1.5}.translation{margin-top:46px}.task{padding:23px 0 27px;border-bottom:1px solid var(--line)}.task-label{font-size:11px;text-transform:uppercase;letter-spacing:.14em;font-weight:700;color:var(--green)}.task-title{font-family:'Libre Baskerville',Georgia,serif;font-size:18px;line-height:1.5;margin:13px 0 17px}.task-title strong{font-weight:700}.task textarea{display:block;width:100%;min-height:66px;resize:vertical;border:1px solid #c8ccc2;background:#fffcf6;border-radius:3px;padding:16px;color:var(--ink);outline:none;font-size:15px}.task textarea:focus{border-color:var(--green);box-shadow:0 0 0 2px #245d451b}.task textarea:disabled{opacity:.75}.actions{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:25px}.primary{border:1px solid var(--green);background:var(--green);color:#fff;border-radius:3px;padding:14px 24px;font-size:13px;font-weight:700}.primary:hover{background:#1c4a37}.secondary{background:transparent;border:1px solid var(--line);border-radius:3px;padding:13px 18px;font-size:13px}.feedback{margin-top:24px;border-top:2px solid var(--green);padding-top:22px}.feedback h3{font-family:'Libre Baskerville',Georgia,serif;font-size:23px;font-weight:400;margin:0 0 10px}.feedback p{font-size:14px;line-height:1.7;color:#536056}.answer-row{margin:13px 0;padding:12px 15px;background:var(--soft);font-size:13px;line-height:1.6}.answer-row b{display:block;color:var(--ink);margin-bottom:4px}.status{display:inline-block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;margin-top:9px}.correct{color:var(--green)}.incorrect{color:var(--red)}.footer{border-top:1px solid var(--line);margin-top:65px;padding-top:20px;display:flex;justify-content:space-between;gap:12px;color:var(--muted);font-size:12px}.hidden{display:none!important}.notice{background:#e9eee7;border-left:3px solid var(--green);padding:13px 17px;font-size:13px;color:#435649;line-height:1.6;margin-top:16px}.footnote{font-size:12px;color:var(--muted);line-height:1.6;margin-top:12px}@media(max-width:620px){.shell{padding:0 20px 65px}.intro{padding-top:42px}.example{grid-template-columns:22px 1fr;gap:7px 12px;padding:16px 0}.english{grid-column:2}.levels{gap:5px}.level{padding:11px 13px}.level small{display:none}.section-head{align-items:start}.top-right{font-size:10px}.footer{display:block}.footer span{display:block;margin-bottom:8px}}
</style></head><body><main class="shell"><header class="top"><div class="brand">lang<span>lang</span><span style="font-size:10px;vertical-align:top;margin-left:5px;letter-spacing:0">®</span></div><div class="top-right">A daily language puzzle</div></header><section class="intro"><div class="eyebrow">Decode the unfamiliar</div><h1>Four clues.<br><em>One new language.</em></h1><p>Every day, decipher a language you've never seen before. Study four examples, uncover the rules, then translate two new sentences.</p></section><div class="bar"><strong id="date-label">Today's puzzles</strong><span>Three languages · One new set each day</span></div><nav class="levels" aria-label="Difficulty"><button class="level active" data-level="easy">Easy <small>01</small></button><button class="level" data-level="hard">Hard <small>02</small></button><button class="level" data-level="expert">Expert <small>03</small></button></nav><section><div class="section-head"><h2 id="puzzle-title">The language</h2><span id="puzzle-meta"></span></div><p class="note">Each line gives the same meaning in two languages. Look for repeating words, endings and patterns. Everything you need is here.</p><div class="examples" id="examples"></div></section><section class="translation"><div class="section-head"><h2>Your translations</h2><span>Two questions</span></div><div class="task"><div class="task-label">01 / Into English</div><div class="task-title" id="prompt-one"></div><textarea id="answer-one" placeholder="Write your English translation…" aria-label="Translate into English"></textarea></div><div class="task"><div class="task-label">02 / Into the new language</div><div class="task-title" id="prompt-two"></div><textarea id="answer-two" placeholder="Write your translation…" aria-label="Translate into the new language"></textarea></div><div class="actions"><button class="primary" id="submit">Check translations</button><button class="secondary hidden" id="share">Share result</button><button class="secondary" id="reset">Clear answers</button></div><p class="footnote">English articles (a / the), punctuation and capitalisation are ignored when checking. Your answers stay on this device.</p><div id="feedback" class="feedback hidden" aria-live="polite"></div></section><footer class="footer"><span>LangLang · A little linguistics, every day.</span><span>New puzzles at midnight UTC · No account required</span></footer></main>
<script>
'use strict';
// Deterministic daily generator. No API key, network call, or server required.
const DAY = new Date().toISOString().slice(0,10);
const dayNumber = Math.floor(Date.parse(DAY+'T00:00:00Z')/86400000);
const pools = {people:['mavi','telo','suna','kori','nema','vilo','rani','pelo','dari','fenu','lomi','tavi','sori','kema','nalu','bira','zelo','mira'],things:['paku','doma','savi','lena','tuko','rima','kavo','noki','balu','fira','moku','zani','peka','soma','vaku','nira','tami','laku'],verbs:['zeta','luma','pira','doka','veta','naso','kira','foma','tura','selo','meka','ravo','tika','nora','pavo','liso']};
function hash(s){let h=2166136261;for(const c of s){h=Math.imul(h^c.charCodeAt(0),16777619)}return h>>>0}
function rng(seed){return ()=>{seed=(Math.imul(seed,1664525)+1013904223)>>>0;return seed/4294967296}}
function shuffled(a,r){a=[...a];for(let i=a.length-1;i>0;i--){let j=Math.floor(r()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
function lexicon(r){const people=shuffled(pools.people,r),things=shuffled(pools.things,r),verbs=shuffled(pools.verbs,r);return {boy:people[0],girl:people[1],woman:people[2],man:people[3],dog:things[0],cat:things[1],bird:things[2],fish:things[3],see:verbs[0],like:verbs[1],follow:verbs[2],find:verbs[3]}}
function cap(s){return s[0].toUpperCase()+s.slice(1)}
function punct(s){return cap(s)+'.'}
const modes={
 easy:[
  {name:'The first words',grammar:'Subject–verb–object word order. Each word has one meaning; there are no verb endings.',examples:[['boy','see','dog'],['girl','see','dog'],['boy','like','cat'],['girl','like','cat']],targets:[['girl','see','cat'],['boy','like','dog']],order:'SVO'},
  {name:'Who does what?',grammar:'Object–subject–verb word order: the thing acted upon comes first, followed by the person and then the verb.',examples:[['boy','see','dog'],['girl','see','dog'],['boy','like','cat'],['girl','like','cat']],targets:[['girl','see','cat'],['boy','like','dog']],order:'OSV'},
  {name:'The last word',grammar:'Subject–object–verb word order. The action comes at the end of the sentence.',examples:[['boy','see','dog'],['girl','see','dog'],['boy','like','cat'],['girl','like','cat']],targets:[['girl','see','cat'],['boy','like','dog']],order:'SOV'}
 ],
 hard:[
  {name:'More than one',grammar:'Subject–object–verb word order. The suffix -en marks plural nouns, and it works for any noun.',examples:[['boy','see','dog'],['girl','see','dog'],['boy','see','dogs'],['girl','like','cat']],targets:[['girl','see','dogs'],['boy','like','dogs']],order:'SOV',plural:'en'},
  {name:'Plural patterns',grammar:'Object–subject–verb word order. The suffix -im makes a noun plural.',examples:[['boy','see','dog'],['girl','see','dog'],['boy','see','dogs'],['girl','like','cat']],targets:[['girl','see','dogs'],['boy','like','dogs']],order:'OSV',plural:'im'},
  {name:'The many',grammar:'Subject–verb–object word order. The prefix ka- makes a noun plural.',examples:[['boy','see','dog'],['girl','see','dog'],['boy','see','dogs'],['girl','like','cat']],targets:[['girl','see','dogs'],['boy','like','dogs']],order:'SVO',plural:'ka-',prefixPlural:true}
 ],
 expert:[
  {name:'Time and absence',grammar:'Subject–object–verb word order. The suffix -ta marks past tense; the separate word nu immediately before a verb marks negation. They can be combined.',examples:[['boy','see','dog'],['girl','see','cat'],['boy','saw','cat'],['girl','notsee','dog']],targets:[['girl','notseePast','cat'],['boy','notseePast','dog']],order:'SOV',past:'ta',negative:'nu'},
  {name:'A different tense',grammar:'Object–subject–verb word order. The prefix ri- marks past tense; the word mo immediately before a verb marks negation. Both rules can apply together.',examples:[['boy','see','dog'],['girl','see','cat'],['boy','saw','cat'],['girl','notsee','dog']],targets:[['girl','notseePast','cat'],['boy','notseePast','dog']],order:'OSV',past:'ri-',prefixPast:true,negative:'mo'},
  {name:'Future and denial',grammar:'Subject–verb–object word order. The suffix -li marks future tense; the separate word va immediately before a verb marks negation. Both rules can apply together.',examples:[['boy','see','dog'],['girl','see','cat'],['boy','willsee','cat'],['girl','notsee','dog']],targets:[['girl','notseeFuture','cat'],['boy','notseeFuture','dog']],order:'SVO',future:'li',negative:'va'}
 ]
};
function english([s,v,o]){const subject='The '+s,object='the '+(o==='dogs'?'dogs':o);const verbs={see:'sees',like:'likes',saw:'saw',notsee:'does not see',notseePast:'did not see',willsee:'will see',notseeFuture:'will not see'};return punct(subject+' '+verbs[v]+' '+object)}
function invented([s,v,o],g,l){let subject=l[s],object=o==='dogs'? (g.prefixPlural?g.plural+l.dog:l.dog+g.plural):l[o];let root=l[v==='like'?'like':'see'];let neg=v.startsWith('not');let tense=v==='saw'||v==='notseePast'?'past':v==='willsee'||v==='notseeFuture'?'future':null;if(tense==='past')root=g.prefixPast?g.past+root:root+g.past;if(tense==='future')root=root+g.future;let verb=(neg?g.negative+' ':'')+root;const chunks={S:subject,V:verb,O:object};return punct(g.order.split('').map(k=>chunks[k]).join(' '))}
function make(level){const r=rng(hash(DAY+':'+level+':langlang-v4'));const templates=modes[level],g=templates[Math.floor(r()*templates.length)],l=lexicon(r);return {...g,lex:l,examples:g.examples.map(x=>[invented(x,g,l),english(x)]),q1:invented(g.targets[0],g,l),a1:english(g.targets[0]),q2:english(g.targets[1]),a2:invented(g.targets[1],g,l)}}
const puzzles={easy:make('easy'),hard:make('hard'),expert:make('expert')};
const $=id=>document.getElementById(id);let current='easy';
function normalize(s,ignoreArticles=false){s=s.toLowerCase().normalize('NFKC').replace(/[‘’]/g,"'").replace(/[^\p{L}\p{N}\s'-]/gu,' ').replace(/\s+/g,' ').trim();if(ignoreArticles)s=s.replace(/\b(a|an|the)\b/g,'').replace(/\s+/g,' ').trim();return s}
function checkEnglish(s,target){let a=normalize(s,true),b=normalize(target,true);if(a===b)return true;const substitutions=[['does not','doesn\'t'],['did not','didn\'t'],['will not','won\'t']];for(const [full,short] of substitutions){a=a.replaceAll(short,full)}return a===b}
function storageKey(){return 'langlang-v4:'+DAY+':'+current}
function load(){try{return JSON.parse(localStorage.getItem(storageKey())||'null')}catch{return null}}
function render(){const p=puzzles[current];document.querySelectorAll('.level').forEach(b=>{const selected=b.dataset.level===current;b.classList.toggle('active',selected);b.setAttribute('aria-pressed',String(selected))});$('puzzle-title').textContent=p.name;$('puzzle-meta').textContent=current.toUpperCase()+' · DAILY '+DAY.replaceAll('-','.');$('examples').replaceChildren();p.examples.forEach(([invented,english],i)=>{const row=document.createElement('div');row.className='example';for(const [cls,value] of [['number',String(i+1).padStart(2,'0')],['invented',invented],['english',english]]){const el=document.createElement('div');el.className=cls;el.textContent=value;row.appendChild(el)}$('examples').appendChild(row)});$('prompt-one').textContent=p.q1;$('prompt-two').textContent=p.q2;const saved=load();$('answer-one').value=saved?.one||'';$('answer-two').value=saved?.two||'';$('answer-one').disabled=!!saved?.done;$('answer-two').disabled=!!saved?.done;$('submit').classList.toggle('hidden',!!saved?.done);$('share').classList.toggle('hidden',!saved?.done);$('reset').classList.toggle('hidden',!!saved?.done);$('feedback').classList.add('hidden');if(saved?.done)showFeedback(saved);}
function showFeedback(saved){const p=puzzles[current],ok1=checkEnglish(saved.one,p.a1),ok2=normalize(saved.two)===normalize(p.a2),score=Number(ok1)+Number(ok2);const box=$('feedback');box.replaceChildren();const h=document.createElement('h3');h.textContent=score===2?'Beautifully deciphered.':score===1?'One translation solved.':'A tricky language today.';box.appendChild(h);const sub=document.createElement('p');sub.textContent=`${score} of 2 translations correct · ${current[0].toUpperCase()+current.slice(1)} · ${DAY}`;box.appendChild(sub);[[ok1,'01 · Into English',p.a1],[ok2,'02 · Into the language',p.a2]].forEach(([ok,label,answer])=>{const row=document.createElement('div');row.className='answer-row';const b=document.createElement('b');b.textContent=label;row.appendChild(b);const ans=document.createElement('span');ans.textContent=answer;row.appendChild(ans);const status=document.createElement('div');status.className='status '+(ok?'correct':'incorrect');status.textContent=ok?'Correct':'Not quite';row.appendChild(status);box.appendChild(row)});const rule=document.createElement('p');const bold=document.createElement('strong');bold.textContent='How the language works: ';rule.appendChild(bold);rule.appendChild(document.createTextNode(p.grammar));box.appendChild(rule);box.classList.remove('hidden')}
$('submit').addEventListener('click',()=>{const one=$('answer-one').value.trim(),two=$('answer-two').value.trim();if(!one||!two){alert('Complete both translations before checking.');return}const saved={one,two,done:true};try{localStorage.setItem(storageKey(),JSON.stringify(saved))}catch{}render();$('feedback').scrollIntoView({behavior:'smooth',block:'nearest'})});
$('reset').addEventListener('click',()=>{$('answer-one').value='';$('answer-two').value='';$('answer-one').focus()});
document.querySelectorAll('.level').forEach(b=>b.addEventListener('click',()=>{current=b.dataset.level;render()}));
$('share').addEventListener('click',async()=>{const saved=load(),p=puzzles[current];if(!saved)return;const score=Number(checkEnglish(saved.one,p.a1))+Number(normalize(saved.two)===normalize(p.a2));const result=`LangLang · ${DAY}\n${current.toUpperCase()} ${score}/2\n${'●'.repeat(score)}${'○'.repeat(2-score)}\nA new language every day.`;try{if(navigator.share)await navigator.share({text:result});else if(navigator.clipboard){await navigator.clipboard.writeText(result);$('share').textContent='Copied!';setTimeout(()=>$('share').textContent='Share result',1800)}else prompt('Copy your result:',result)}catch{}});
$('date-label').textContent=new Date(DAY+'T12:00:00Z').toLocaleDateString('en-GB',{weekday:'long',day:'numeric',month:'long',year:'numeric',timeZone:'UTC'});
render();
</script></body></html>
